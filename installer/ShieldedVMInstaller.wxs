<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Shielded VM Appliance"
           Language="1033"
           Version="1.0.0"
           Manufacturer="BashJS"
           UpgradeCode="1F5AF0AE-87F9-42D8-93B3-9C468830389A">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"/>

    <MajorUpgrade AllowDowngrades="no" DowngradeErrorMessage="A newer version of the Shielded VM Appliance installer is already present."/>
    <MediaTemplate/>

    <Property Id="ARPNOMODIFY" Value="1"/>
    <Property Id="ARPNOREPAIR" Value="1"/>

    <Property Id="APPLIANCEURL" Value="https://example.com/path/to/appliance.vhdx"/>
    <Property Id="VMNAME" Value="CriticalAppliance"/>
    <Property Id="SHIELDINGDATAFILE" Value=""/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="Shielded VM Appliance">
          <Component Id="Cmp_ConfigureShieldedVM" Guid="*">
            <File Id="Fil_ConfigureShieldedVM" Source="$(var.ProjectDir)installer\ConfigureShieldedVM.ps1" KeyPath="yes"/>
          </Component>
        </Directory>
      </Directory>
    </Directory>

    <Feature Id="MainFeature" Title="Shielded VM Provisioning" Level="1">
      <ComponentRef Id="Cmp_ConfigureShieldedVM"/>
    </Feature>

    <Binary Id="WixCA" SourceFile="$(var.WixCATarget)"/>

    <CustomAction Id="SetConfigureShieldedVMCommand"
                  Property="ConfigureShieldedVM"
                  Execute="immediate">
      <![CDATA[powershell.exe -NoProfile -ExecutionPolicy Bypass -File "[INSTALLFOLDER]ConfigureShieldedVM.ps1" -ApplianceUrl "[APPLIANCEURL]" -VmName "[VMNAME]" -ShieldingDataPath "[SHIELDINGDATAFILE]"]]>
    </CustomAction>

    <CustomAction Id="ConfigureShieldedVM"
                  BinaryKey="WixCA"
                  DllEntry="CAQuietExec64"
                  Execute="deferred"
                  Return="check"
                  Impersonate="no"/>

    <InstallExecuteSequence>
      <Custom Action="SetConfigureShieldedVMCommand" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="ConfigureShieldedVM" After="SetConfigureShieldedVMCommand">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
